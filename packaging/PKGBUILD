# Maintainer: Chibani <11yzyv86j@relay.firefox.com>
pkgname="distro-snapper-git"
pkgver=r470.9953135
pkgrel=1
pkgdesc="Manage immutable tree-shaped btrfs snapshots."
url="https://github.com/ochibani/dsnap"
arch=("x86_64")
license=("AGPL-3.0-only")
depends=("btrfs-progs" "coreutils" "curl" "efibootmgr" "gnupg" "pacman" "paru" "python-anytree" "rc-local")
makedepends=("cargo" "git")
optdepends=("grub" "systemd")
provides=("distro-snapper")
conflicts=("distro-snapper")
source=("$pkgname::git+https://github.com/ochibani/dsnap.git")
sha512sums=('SKIP')

pkgver() {
  cd "$pkgname"
  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cd "$pkgname"
  export PYO3_USE_ABI3_FORWARD_COMPATIBILITY=1
  cargo build --release --locked --target-dir=target
}

package() {
  install -d -m755 "$pkgdir/etc/dsnap/export-keys"
  mkdir -p "$pkgdir/usr/bin/"
  cd "$pkgname"
  install -Dm755 "target/release/dsnap" "${pkgdir}/usr/bin/dsnap"
  install -Dm644 "packaging/systemd/dsnap-auto-upgrade.service" "${pkgdir}/usr/lib/systemd/system/dsnap-auto-upgrade.service"
  install -Dm644 "packaging/systemd/dsnap-auto-upgrade.timer" "${pkgdir}/usr/lib/systemd/system/dsnap-auto-upgrade.timer"
  install -Dm644 "target/release/build/dsnap-"*"/out/dsnap.8" "${pkgdir}/usr/share/man/man8/dsnap.8"
  for manpage in "target/release/build/dsnap-"*"/out/dsnap-"*.8; do
    install -Dm644 "$manpage" "${pkgdir}/usr/share/man/man8/$(basename "$manpage")"
  done
  install -Dm644 "target/release/build/dsnap-"*"/out/dsnap.bash" "${pkgdir}/usr/share/bash-completion/completions/dsnap"
  install -Dm644 "target/release/build/dsnap-"*"/out/_dsnap" "${pkgdir}/usr/share/zsh/site-functions/_dsnap"
  install -Dm644 "target/release/build/dsnap-"*"/out/dsnap.fish" "${pkgdir}/usr/share/fish/vendor_completions.d/dsnap.fish"
}
